{
  "name": "claimsathi-server",
  "version": "1.0.0",
  "private": true,
  "description": "Claim Saathi API: AI health-insurance claim companion (Team Fear Fighters, Paytm Hackathon Track 2)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "gen:sql": "tsx scripts/gen-sql.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
