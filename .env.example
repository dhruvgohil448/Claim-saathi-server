# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed dashboard / app origins ("*" allows all)
CORS_ORIGIN=*
# Long random string used to sign JWTs and file links
JWT_SECRET=

# ---------- Database (Supabase Postgres) ----------
# Transaction pooler (port 6543) used by the running app:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Session pooler / direct (port 5432) used by prisma db push:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ---------- Supabase Storage ----------
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key: Supabase dashboard > Project Settings > API Keys. Leave blank to store files on local disk (uploads/).
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=claim-files

# ---------- AI ----------
# true = rule-based AI that needs no API key (default, great for demos)
MOCK_AI=true
# openai | gemini (used only when MOCK_AI=false)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# rules | llm  (llm = the agent plans its next steps with function calling; rules = deterministic)
AGENT_PLANNER=rules
# Run tesseract.js OCR on image uploads (downloads language data on first use)
OCR_ENABLED=false

# ---------- Claim Agent ----------
AUTO_VERIFY_CONFIDENCE=0.8
ESCALATION_AMOUNT=100000
# Follow-up job for stuck claims
FOLLOWUP_CRON="*/5 * * * *"
STUCK_AFTER_MINUTES=240
MAX_REMINDERS=2
# Approved reimbursement claims are marked SETTLED (simulated NEFT payout) after this many minutes. 0 disables.
AUTO_SETTLE_AFTER_MINUTES=10

# Demo OTP for the mobile app (no SMS is sent; every OTP step accepts only this code)
OTP_DEMO_CODE=111000
